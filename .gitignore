# Explicit public source tree; historical/local files stay on disk.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.ru.md
!/LICENSE
!/NOTICE.md
!/CONTRIBUTING.md
!/AndroidManifest.xml
!/build.py
!/build_launchers.py
!/build_tests.py
!/src/
!/res/
!/assets/
!/launchers/
!/third_party/
!/tests/
!/tools/
!/docs/
!/.github/

# Keys and generated outputs must never enter Git.
*.p12
*.jks
*.keystore
*.pem
*.apk
*.idsig
*.class
*.dex
*.zip
*.pyc
**/__pycache__/
.DS_Store
.env
.env.*

# Real vehicle captures, private replay fixtures and historical reports.
/tests/runner/assets/
/tests/*.json
/tests/*.txt
/tests/host/**/*.md
/tests/host/**/*.json
/tools/*
!/tools/decode_bsj_log.py
!/tools/test_decode_bsj_log.py
!/tools/package_release.py
!/tools/stock_overlay_adb.py
!/tools/PrepareAppIcons.java
!/tools/PrepareSplashIcons.java
